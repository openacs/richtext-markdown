<template id="richtext-markdown-toolbar">
  <div>
    <adp:button type="button" class="action active" data-markdown-mode="write" aria-pressed="true">#richtext-markdown.Write#</adp:button>
    <adp:button type="button" class="action" data-markdown-mode="preview" aria-pressed="false">#richtext-markdown.Preview#</adp:button>
  </div>
</template>
